# ── Приложение ───────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true

# ── PostgreSQL (единая транзакционная БД) ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://orakul:orakul@localhost:5432/orakul

# Раздельные роли БД (T9, см. backend/README.md «Роль БД приложения»): в проде
# приложение должно ходить непривилегированной ролью orakul_app (нет
# UPDATE/DELETE на append-only — audit_log/resolutions/ledger_*/season_finalizations*/
# user_consents), а миграции — владельцем схемы. Локально не разделяем (владелец
# и там, и там — проще для дева), поэтому оба варианта ниже закомментированы.
# DATABASE_URL=postgresql+asyncpg://orakul_app:change-me-app-role-password@localhost:5432/orakul
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://orakul:orakul@localhost:5432/orakul

# Бутстрап роли orakul_app (scripts/create_app_role.py) — переменные читает
# только сам скрипт, приложением не используются.
# APP_DB_ROLE=orakul_app
# APP_DB_PASSWORD=change-me-app-role-password

# ── Redis (кэш + брокер + state/refresh-store) ────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Rate limiting (ARCHITECTURE.md §6) ────────────────────────────────────
# Лимиты запросов с одного IP в минуту, включаются вне APP_ENV=local. 0 —
# выключено. При недоступном Redis: общий лимит — fail-open (пропускает),
# auth-лимит — fail-closed (503), см. app/middleware/rate_limit.py.
RATE_LIMIT_PER_MINUTE=300
# Отдельный, более жёсткий лимит для /auth/* (инициация ЕСИА, callback,
# refresh) — защита от брутфорса/подбора состояний и токенов.
RATE_LIMIT_AUTH_PER_MINUTE=20

# ── Криптография ПДн (152-ФЗ) ─────────────────────────────────────────────
# HMAC-ключ для snils_hash (ключ уникальности «1 человек = 1 аккаунт»). >= 32 байт.
SECURITY_SNILS_HMAC_KEY=change-me-snils-hmac-secret-min-32-bytes
# Fernet-ключ для шифрования ФИО (real_name_enc). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_FIELD_ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64-fernet-key=

# ── JWT-сессии ────────────────────────────────────────────────────────────
# JWT-подпись (HS256). >= 32 байт.
SECURITY_JWT_SECRET=change-me-jwt-secret-min-32-bytes-long
SECURITY_JWT_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_TTL_SECONDS=900
SECURITY_REFRESH_TOKEN_TTL_SECONDS=2592000
SECURITY_COOKIE_SECURE=true
SECURITY_COOKIE_DOMAIN=

# ── ЕСИА (OIDC) — через сертифицированный шлюз/интегратора ─────────────────
# TODO(identity-infra): значения выдаёт интегратор, держащий СКЗИ КС3/ФСБ.
ESIA_CLIENT_ID=orakul-mnemonic
ESIA_REDIRECT_URI=https://orakul.example/auth/esia/callback
ESIA_AUTHORIZATION_ENDPOINT=https://esia-gateway.example/aas/oauth2/ac
ESIA_TOKEN_ENDPOINT=https://esia-gateway.example/aas/oauth2/te
ESIA_USERINFO_ENDPOINT=https://esia-gateway.example/rs/prns
ESIA_SCOPES=openid snils fullname
ESIA_REQUIRE_CONFIRMED=true
# Проверка id_token (подпись по JWKS + iss/aud/exp/nonce). ОБЯЗАТЕЛЬНА вне
# APP_ENV=local: пустой ESIA_JWKS_URL валит старт приложения (пустой = режим
# «доверие каналу», допустим только с локальным моком).
# Локально с моком ЕСИА (web/dev/mock-esia на :9000):
#   ESIA_ISSUER=http://localhost:9000
#   ESIA_JWKS_URL=http://localhost:9000/jwks
ESIA_ISSUER=https://esia-gateway.example
ESIA_JWKS_URL=https://esia-gateway.example/jwks
# Сколько секунд держать ключи JWKS в памяти (неизвестный kid обновляет кэш
# принудительно, вне расписания).
ESIA_JWKS_CACHE_TTL_SECONDS=3600
# Допустимые алгоритмы подписи id_token (уточнить у интегратора).
ESIA_ID_TOKEN_ALGORITHMS=RS256

# ── Сезоны ────────────────────────────────────────────────────────────────
# Авто-финализация истёкших сезонов в таймерном season_roll. Боевой
# DisputeGuard блокирует закрытие сезона с открытыми спорами, поэтому ВКЛ.
SEASONS_AUTO_FINALIZE=true

# ── Разрешение споров ─────────────────────────────────────────────────────
# Длительность окна оспаривания после фиксации/пересмотра исхода, в часах.
RESOLUTIONS_DISPUTE_WINDOW_HOURS=72

# ── Юридические документы и согласия (152-ФЗ) ─────────────────────────────
# Текущие версии обязательных документов (дата редакции опубликованного на
# /legal текста). Меняет ЮРИСТ — без пересборки образа: у всех, кто принял
# более старую версию, тут же появляется недостающее согласие
# (needs_onboarding=true в GET /auth/me), а участие в конкурсе — постановка
# прогноза и предложение события — блокируется 403 ConsentRequiredError до
# переподтверждения.
CONSENTS_OFFER_VERSION=2026-07-05
CONSENTS_PDN_VERSION=2026-07-05

# ── Платежи (операционная касса) ──────────────────────────────────────────
# Цены тарифов подписки в копейках (никогда не float). Совпадают с дефолтами
# BillingSettings и статикой фронта (web/lib/pricing.ts).
BILLING_DAILY_PRICE_KOPECKS=9900
BILLING_WEEKLY_PRICE_KOPECKS=49900
BILLING_MONTHLY_PRICE_KOPECKS=99000
BILLING_ANNUAL_PRICE_KOPECKS=499000

# Явный выбор платёжных провайдеров (fail-fast, см. Settings в app/config.py):
# вне APP_ENV=local checkout обязан быть tbank (с полными настройками ниже),
# payout — jump (с полными настройками ниже) либо явный manual («вручную»).
BILLING_CHECKOUT_PROVIDER=local
BILLING_PAYOUT_PROVIDER=manual

# ── Эквайринг ТБанк (приём платежей за подписку) ──────────────────────────
# enabled=true включает адаптер ТБанк (требуется, если BILLING_CHECKOUT_PROVIDER=tbank).
# Креды — из кабинета ТБанк, в git НЕ коммитить (терминал с DEMO — тестовый).
TBANK_ENABLED=false
# TBANK_TERMINAL_KEY=1783427792728DEMO
# TBANK_PASSWORD=change-me-terminal-password
# TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2

# ── Выплаты Jump.Finance (призовой фонд, СБП по телефону) ─────────────────
# enabled=true включает Jump (требуется, если BILLING_PAYOUT_PROVIDER=jump).
# Ключ — из ЛК Jump: Настройки → Интеграции → OpenAPI (показывается один раз).
# Песочницы у Jump нет: для тестов включить в ЛК режим «Требующие
# подтверждения». agent_id/bank_account_id — из GET /banks_accounts.
JUMP_ENABLED=false
# JUMP_API_KEY=change-me-jump-client-key
# JUMP_AGENT_ID=1
# JUMP_BANK_ACCOUNT_ID=1
# JUMP_API_BASE_URL=https://api.jump.finance/services/openapi
